# ---------------------------------------------------------------------------
# RBX Family Manager - environment configuration
# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Bot token from the Discord Developer Portal -> Bot -> Token.
DISCORD_TOKEN=MTU1NzAzMjQ4OTkwNDUwNDkwNA.Ga1gAH.iGxYzEwn7R-JwK49uHvWQjUyTmBAbOoUkavG8E

# Your Discord user ID (Developer Mode -> Right click -> Copy User ID).
# Separate multiple owners with spaces or commas.
OWNER_ID=1314448269845336127

# Path to the SQLite database file. Relative paths resolve from the project root.
DATABASE_PATH=data/rbx_family.db

# Optional: guild ID for instant slash-command sync during development.
# Leave empty to sync commands globally (can take up to 1 hour to propagate).
DEV_GUILD_ID=1533762437860294746

# Optional: tiny health endpoint (GET /health) for uptime monitoring.
HEALTH_ENABLED=true
HEALTH_PORT=8080

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/rbx_family.log

# Set to false to skip automatic slash-command syncing (e.g. CI environments).
SYNC_COMMANDS=true
